{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@/*": ["./*"],
      "@gb-locacoes/frontend/app": ["./packages/frontend/src/app/index.web.ts"],
      "@gb-locacoes/frontend/pages/*": [
        "./packages/frontend/src/pages/*/index.ts"
      ],
      "@gb-locacoes/ui": ["./packages/ui/src/index.web.ts"],
      "@gb-locacoes/design-tokens": ["./packages/design-tokens/src/index.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["types/next-auth.d.ts", "prisma/**/*.ts", "prisma.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.native.ts",
    "**/*.native.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
