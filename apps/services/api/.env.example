# API compartilhada (apps/services/api). Valores locais de exemplo; não alteram nenhum ambiente existente.
# Manifesto do corte, com o valor de produção de cada variável: docs/operations/manifesto-variaveis.md
# (tests/unit/env-manifest.test.ts confere este arquivo com ele e com o código).
# Configure SOMENTE o banco do ambiente alvo, com papel de runtime sem ownership,
# SUPERUSER ou BYPASSRLS. Não copie credenciais de produção para testes.
DATABASE_URL=""
# Papel platform_runtime, separado do banco de negócio. Nunca usa DATABASE_URL como fallback.
# Configuração ausente mantém /api/cron/platform indisponível (503).
PLATFORM_DATABASE_URL=""
# Configuração opcional enquanto todas as integrações usarem ENV_REF. VAULT falha fechada sem KEK.
# A chave de cada KEK fica em PLATFORM_SECRETS_KEK_<ID> (32 bytes em base64), como a K1 abaixo.
PLATFORM_SECRETS_KEK_PROVIDER="env"
PLATFORM_SECRETS_KEK_CURRENT=""
PLATFORM_SECRETS_KEK_K1=""
PLATFORM_SECRETS_KMS_KEY_ARN=""
PLATFORM_SECRET_FINGERPRINT_KEY=""
# on exige aws-kms, chave sa-east-1 e federação OIDC; não ativa cadastro ou scheduler.
PLATFORM_SELF_SERVICE_SIGNUP="off"
# off | shadow | on. Mesmo modo do legado; on exige preflight e aceite do S8 completo.
# Primeiro corte: admissão transacional de cadastro de equipamentos; não ativa os demais módulos.
PLATFORM_SUBSCRIPTION_ENFORCEMENT="off"
AWS_ROLE_ARN=""
AWS_WEB_IDENTITY_TOKEN_FILE=""
# Desligar somente após a migração assistida e verificada de todas as integrações. Enquanto true, as variáveis
# Para env:LOCADORA_INTEGRATION_<ID>, a variável base não é lida: use os sufixos
# _SECRET (obrigatório), _VERIFY_TOKEN, _API_KEY, _ENVIRONMENT e _USER_AGENT conforme a integração.
INTEGRATION_ENV_REFS_ALLOWED="true"
# Contexto autenticado do proxy web; mesma configuração usada pelo backend legado.
PLATFORM_ENV="development"
PLATFORM_ROOT_DOMAIN=""
PLATFORM_EDGE_SECRET=""
PLATFORM_EDGE_SECRET_PREVIOUS=""
# Mesma chave (32+ caracteres) em todas as instâncias e no legado durante a migração.
PLATFORM_RATE_LIMIT_SECRET=""
# Só configure quando a infraestrutura garantir a cadeia de proxies correspondente.
TRUSTED_PROXY_HOPS=""
# Origem esperada de mutações sem borda validada; com a borda, vale a origem do host.
WEB_PUBLIC_ORIGIN=""
# Leitura de sessão usa os mesmos modos/segredos/cookies do legado. O corte de produção usa
# AUTH_MODE="better-auth" (decisão D3), igual ao NEXT_PUBLIC_AUTH_MODE do web; o exemplo local mantém legacy.
AUTH_MODE="legacy"
AUTH_V2_ENABLED=""
NEXTAUTH_URL=""
NEXTAUTH_SECRET=""
# Só como reserva de NEXTAUTH_SECRET.
AUTH_SECRET=""
NEXTAUTH_DEBUG="false"
BETTER_AUTH_URL=""
BETTER_AUTH_SECRET=""
AUTH_TRUSTED_ORIGINS=""
AUTH_CREDENTIAL_WRITES_PAUSED=""
# OAuth da identidade: callbacks em https://app.<raiz>/api/auth/callback/<provedor> (runbook do corte, 7.2-11).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Identidade e avisos comerciais usam o mesmo transporte Resend. Leitura de
# sessão não envia e-mail; cron/platform só compõe avisos com chave/remetente,
# PLATFORM_ASAAS_ENVIRONMENT e host explícitos. Ausente: avisos ficam PENDING.
RESEND_API_KEY=""
FROM_EMAIL=""
# Storage de documentos privados e imagens (Supabase); só no servidor.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Caixa de e-mail do painel (Zoho). O redirect é fixo em https://app.<raiz>/api/admin/zoho-mail/oauth/callback;
# ZOHO_REDIRECT_URI ausente ou exatamente esse valor (outro valor lança erro).
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_MAIL_DATACENTER="com"
ZOHO_REDIRECT_URI=""
# Plataforma SaaS (docs/architecture/adr-saas-subscription.md, B.14). Origem pública desta API para os webhooks
# das subcontas: fixa para sempre depois de configurar a primeira conta (WEBHOOK_OWNERSHIP_CONFLICT).
PLATFORM_WEBHOOK_ORIGIN=""
PLATFORM_OPS_EMAIL=""
PLATFORM_ASAAS_ENVIRONMENT="sandbox"
PLATFORM_ASAAS_ROOT_API_KEY=""
PLATFORM_ASAAS_ROOT_WEBHOOK_TOKEN_SHA256=""
PLATFORM_ASAAS_ROOT_WEBHOOK_TOKEN_PREVIOUS_SHA256=""
PLATFORM_ASAAS_SUBACCOUNT_MODEL="STANDARD"
PLATFORM_SUBACCOUNT_CREATION="off"
PLATFORM_SUBACCOUNT_REQUIRES_PAID="true"
PLATFORM_ASAAS_EGRESS_PROXY_URL=""
PLATFORM_ASAAS_OUTBOUND_DISABLED="false"
# Cadastro de locadora (onboarding); só lidos com o cadastro ligado.
PLATFORM_TRIAL_SECRET=""
PLATFORM_LEGAL_DOCUMENTS_FILE=""
PLATFORM_LEGAL_DOCUMENT_CONTENTS_FILE=""
PLATFORM_CAPTCHA_SITE_KEY=""
PLATFORM_CAPTCHA_SECRET_KEY=""
# true gera o boleto na aprovação do orçamento.
AUTO_GENERATE_BOLETO_ON_QUOTE=""
LOG_LEVEL="info"
# Autorização dos jobs. A agenda da Vercel mora em apps/services/api/vercel.json (late-fees, expire-quotes e
# outbox) e só vale em deploy de produção deste projeto; nos crons dele a Vercel envia este valor como
# "Authorization: Bearer". Os demais jobs vêm do cron-dispatch do GitHub (D10), com o mesmo segredo.
# Ligar a agenda é passo do corte (docs/operations/runbook-corte-raiz-legada.md, 7.2-9), não deste arquivo.
CRON_SECRET=""
# Sem borda validada, GET /api/categories exige ?tenantSlug= explicitamente.
# Não configurar WEB_API_ORIGIN neste serviço; ela pertence ao cliente web.
