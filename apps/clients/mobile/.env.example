# Valores de exemplo para o host Expo; não ativam migração de identidade.
# Em dispositivo físico, 127.0.0.1 é o próprio aparelho: usar origens acessíveis
# do ambiente de desenvolvimento. Nunca colocar segredos em EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL="http://127.0.0.1:3002"
EXPO_PUBLIC_AUTH_MODE="legacy"
# Arquivos públicos do web, separados da API. URLs absolutas de storage não mudam.
# Ausente/vazia: preserva o comportamento anterior, usando EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_ASSET_URL="http://localhost:3001"
# Painel web autenticado para consultar faturas; informe só a origem.
# Não usa a origem da API como fallback e não transporta cookies ou tokens do app.
# Em produção, exige https; deixe vazio se o painel ainda não estiver configurado.
EXPO_PUBLIC_WEB_URL=""
# Rollback local: API_URL para http://127.0.0.1:3000; ASSET_URL pode permanecer no web.
