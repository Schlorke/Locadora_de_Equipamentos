# Cliente web fino. Valores locais de exemplo; não alteram nenhum ambiente existente.
# Manifesto do corte, com o valor de produção de cada variável: docs/operations/manifesto-variaveis.md
# (tests/unit/env-manifest.test.ts confere este arquivo com ele e com o código).
PLATFORM_ENV="development"
PLATFORM_ROOT_DOMAIN="localhost"
PLATFORM_PUBLIC_PORT="3001"
# Mesmo segredo no web e no serviço; preencher sem publicar credenciais.
PLATFORM_EDGE_SECRET=""
# Valor anterior durante a rotação, igual ao do serviço.
PLATFORM_EDGE_SECRET_PREVIOUS=""
# Rotas de laboratório no host app; ignorado em produção.
PLATFORM_LABS_ENABLED="false"
# API compartilhada. A raiz app/ foi retirada; retorno local só para um clone completo da tag de pré-exclusão, com origem própria validada.
# Não apontar para uma porta legada presumida; nenhum fallback foi iniciado por este exemplo.
# Fora de development é obrigatória uma origem https, sem caminho/credenciais/query.
WEB_API_ORIGIN="http://127.0.0.1:3002"
# Embutida no build; o corte de produção usa better-auth (decisão D3), igual ao AUTH_MODE da API.
NEXT_PUBLIC_AUTH_MODE="legacy"
# URL do projeto Supabase (a mesma da API), lida no build: o hostname entra em images.remotePatterns do next/image.
NEXT_PUBLIC_SUPABASE_URL=""
# Mapa da página de contato (opcional): Maps JavaScript, Places, Directions e Distance Matrix.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
# public/ é sincronizado no predev/prebuild e servido pelo web; não pertence à origem da API.
