# Exemplo de configuração .env.local

# Database (Prisma + Supabase)
DATABASE_URL="postgresql://username:password@host:port/database?schema=public"
DIRECT_URL="postgresql://username:password@host:port/database?schema=public"

# Test configuration
TEST_DATABASE_URL="postgresql://test:test@127.0.0.1:5432/test_locadora"
TEST_DATABASE_DISPOSABLE="true"
# Somente leitura: use a role real de runtime, nunca superuser.
TENANT_RUNTIME_DATABASE_URL=""
TEST_PORT="3101"
TEST_BASE_URL="http://localhost:3101"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# OAuth Providers
# Google OAuth - Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth - Obtenha em: https://developers.facebook.com/apps
# Callback URL deve ser: {NEXTAUTH_URL}/api/auth/callback/facebook
# Em desenvolvimento: http://localhost:3000/api/auth/callback/facebook
# Em produção: https://plataforma.example/api/auth/callback/facebook
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Email (Resend)
# Avisos comerciais usam este transporte no cron já existente; configuração
# explícita de FROM_EMAIL e PLATFORM_ASAAS_ENVIRONMENT também é obrigatória.
RESEND_API_KEY="your-resend-api-key"

# Asaas legado sem uso no código: remoção prevista no lote S17
# (docs/architecture/adr-saas-subscription.md, B.14).
ASAAS_API_KEY="your-asaas-api-key"
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_WEBHOOK_SECRET="your-asaas-webhook-token"

# Logging
LOG_LEVEL="info"

# NextAuth Debug Mode (set to 'true' to enable debug logging)
NEXTAUTH_DEBUG=false

CRON_SECRET="xxxxxxx"
CRON_BASE_URL="https://plataforma.example"

# Zoho Mail (Admin Panel - integracao inbox)
ZOHO_CLIENT_ID="your-zoho-client-id"
ZOHO_CLIENT_SECRET="your-zoho-client-secret"
ZOHO_MAIL_DATACENTER="com"
# Opcional: URI de redirecionamento OAuth (se omitido, usa NEXTAUTH_URL + /api/admin/zoho-mail/oauth/callback)
# Use se o Zoho tiver registrado um dominio diferente (ex.: sem www) do NEXTAUTH_URL.
# ZOHO_REDIRECT_URI="https://plataforma.example/api/admin/zoho-mail/oauth/callback"

# Google Maps (localizador na página de contato - Store Locator)
# Obtenha a chave em: Google Cloud Console > APIs e serviços > Credenciais
# APIs necessárias: Maps JavaScript API, Places API, Directions API, Distance Matrix API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="sua-chave-google-maps"
# Opcional: ID do mapa customizado (Cloud-based Map ID) para estilos próprios
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Google Analytics (gtag.js) - ID de medição (ex.: G-XXXXXXXXXX)
# Configure para ativar o rastreamento no site. Deixe vazio para desativar.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Ads - ID da tag de conversão/remarketing (ex.: AW-XXXXXXXXXX)
# Usado para o teste de conexão e conversões no Google Ads. Padrão: AW-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXXX"

# Verificação de domínio (Search Console, Meta Business Manager)
# Nunca commitar tokens reais; usar apenas em .env.local / ambiente de deploy.
# GOOGLE_SITE_VERIFICATION="seu-codigo-google-site-verification"
# FACEBOOK_DOMAIN_VERIFICATION="seu-codigo-facebook-domain-verification"

# WhatsApp (Admin Panel - Meta Cloud API)
# O webhook deve ser acessível pela Meta via HTTPS (ex.: https://plataforma.example/api/webhooks/whatsapp).
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-access-token"
WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# Google Merchant Center
# Sincroniza catálogo de equipamentos com Google Merchant para Google Shopping e Performance Max
# Usa Content API for Shopping v2.1 (API atual recomendada pelo Google)
# 1. Acesse https://merchants.google.com e crie/selecione sua conta Merchant
# 2. No Google Cloud Console, ative a Merchant API (merchantapi.googleapis.com)
# 3. Crie um Service Account e baixe o JSON da chave
# 4. Adicione o Service Account ao Merchant Center com permissão de Administrador
# 5. Extraia os valores abaixo do arquivo JSON
GOOGLE_MERCHANT_ID="1234567890"
GOOGLE_MERCHANT_SERVICE_ACCOUNT_EMAIL="service-account@project-id.iam.gserviceaccount.com"
GOOGLE_MERCHANT_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0B...\n-----END PRIVATE KEY-----\n"

# Identidade expansiva: não habilitar corte sem preflight/backfill e reautenticação.
# Login do cliente em subdomínio de locadora exige AUTH_MODE="better-auth".
AUTH_MODE="legacy"
AUTH_V2_ENABLED="false"
AUTH_CREDENTIAL_WRITES_PAUSED="false"
# Com resolução por host: em produção, https://app.<PLATFORM_ROOT_DOMAIN>.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
# Scheme do app (packages/contracts/src/platform.json, ex.: locadora://);
# exp:// só em desenvolvimento. Curinga é proibido.
AUTH_TRUSTED_ORIGINS=""
# A ser aposentada: o nome provisório passa a vir de
# packages/contracts/src/platform.json quando lib/identity.ts migrar.
PLATFORM_NAME=""
# Remetente Resend validado. Ausente: jobs de aviso comercial ficam PENDING.
FROM_EMAIL=""

# Exemplo de referência TenantIntegration.credentialsRef:
# env:LOCADORA_INTEGRATION_EXAMPLE
# Nunca reutilizar uma credencial global entre locadoras.
LOCADORA_INTEGRATION_EXAMPLE_SECRET=""
LOCADORA_INTEGRATION_EXAMPLE_API_KEY=""
LOCADORA_INTEGRATION_EXAMPLE_VERIFY_TOKEN=""
LOCADORA_INTEGRATION_EXAMPLE_ENVIRONMENT="sandbox"

# Host web transicional: destino de API configurável; nenhuma origem de produção é inferida.
# O host web novo encaminha /api ao destino por esta origem privada
# (somente a origem HTTP(S), sem caminho). Configure no processo web; não usar
# prefixo NEXT_PUBLIC. Obrigatória em produção e sempre https fora de development.
WEB_API_ORIGIN="http://127.0.0.1:3000"
# O serviço apps/services/api roda localmente em 3002, com todos os 193 métodos montados.
# O exemplo da raiz conserva o legado em 3000. O exemplo próprio do web permite
# ensaio reversível em 3002; nenhuma configuração real é alterada por estes exemplos.
# Os arquivos públicos pertencem ao web e não seguem por WEB_API_ORIGIN.
# Ambiente próprio: apps/services/api/.env.example; docs/features/shared-api-host.md.
# Configure no backend a origem pública exata usada pelo navegador.
# O frontend e o backend precisam compartilhar a origem pública canônica de autenticação/CSRF.
# Alinhar NEXTAUTH_URL/BETTER_AUTH_URL a ela; não usar cabeçalhos forwarded como autoridade.
# Com resolução por host, vale só para requisições sem contexto de borda.
WEB_PUBLIC_ORIGIN=""

# Plataforma multiempresa: locadora resolvida pelo host
# (docs/architecture/adr-tenant-hosts.md). Nome provisório e subdomínios
# reservados ficam em packages/contracts/src/platform.json, não em variáveis.
# Domínio raiz sem esquema, porta, caminho ou ponto final. Obrigatório fora de
# development; em development o padrão é localhost (http://localhost:3001,
# http://app.localhost:3001 e http://<slug>.localhost:3001).
PLATFORM_ROOT_DOMAIN=""
# development | preview | staging | production. Se ausente, VERCEL_ENV ou
# NODE_ENV=production contam como production. Produção exige https e proíbe labs.
PLATFORM_ENV="development"
# Só em development: porta pública do host web (o legado roda em 3000).
PLATFORM_PUBLIC_PORT="3001"
# Segredo compartilhado proxy -> backend (32 caracteres ou mais), gerado por
# ambiente. Obrigatório em produção. Rotação: mova o valor atual para
# PLATFORM_EDGE_SECRET_PREVIOUS e gere um novo.
PLATFORM_EDGE_SECRET=""
PLATFORM_EDGE_SECRET_PREVIOUS=""
# Rotas de laboratório no host app. Ignorado em produção.
PLATFORM_LABS_ENABLED="false"
# Domínios próprios das locadoras: reservado para a fase de domínios próprios; sem efeito até lá.
PLATFORM_CUSTOM_DOMAINS="off"
# Invalidação de cache por locadora (fase de ISR). 32 caracteres ou mais.
PLATFORM_REVALIDATE_SECRET=""
# HMAC do IP e do e-mail nas janelas persistentes de rate limit (login,
# recuperação de senha, cadastro e diretório público). 32 caracteres ou mais,
# o mesmo valor em todas as instâncias. Obrigatória em produção: sem ela os
# limitadores recusam (erro de configuração). Fora de produção, chave local.
PLATFORM_RATE_LIMIT_SECRET=""
# IP do cliente nas janelas por IP fora da Vercel e sem borda validada: número
# de proxies confiáveis que ACRESCENTAM ao X-Forwarded-For (vale a N-ésima
# entrada da direita). Ex.: "1" com um balanceador na frente do `next start`.
# Vazio: sem borda, sem VERCEL=1 e em produção nenhum cabeçalho é confiável e
# não há janela por IP. Nunca maior que o número real de saltos (o cliente
# forjaria o IP).
TRUSTED_PROXY_HOPS=""
# Arquivos de associação dos links universais (Apple Team ID e fingerprint
# SHA-256 do certificado Android).
PLATFORM_IOS_TEAM_ID=""
PLATFORM_ANDROID_CERT_SHA256=""

# Plataforma SaaS por assinatura (docs/architecture/adr-saas-subscription.md,
# B.14). Valores reais só no ambiente de cada deploy; nunca em arquivo versionado.
# Papel platform_runtime (tabelas de plataforma e sementes do onboarding).
PLATFORM_DATABASE_URL=""
# Só a checagem (pnpm tenant:check) usa esta URL para verificar o papel.
PLATFORM_RUNTIME_DATABASE_URL=""
# Conta raiz do Asaas (mensalidade). Lidas só na composição de subscriptions e
# payment-accounts; cobrança de cliente final nunca usa a conta raiz.
PLATFORM_ASAAS_ENVIRONMENT="sandbox"
PLATFORM_ASAAS_ROOT_API_KEY=""
PLATFORM_ASAAS_ROOT_ACCOUNT_ID=""
# Webhooks da raiz e da validação de saque: só o SHA-256 (hex) do token.
# Rotação: mova o hash atual para _PREVIOUS_SHA256 (aceito por até 24 h).
PLATFORM_ASAAS_ROOT_WEBHOOK_TOKEN_SHA256=""
PLATFORM_ASAAS_ROOT_WEBHOOK_TOKEN_PREVIOUS_SHA256=""
PLATFORM_ASAAS_TRANSFER_VALIDATION_TOKEN_SHA256=""
# Criação da conta de recebimentos pelo dono (onda 134): off por padrão; ligar
# é ato do lote S16. off devolve ao dono os pedidos que ainda não chegaram ao
# Asaas; para pausar sem cancelar, use PLATFORM_ASAAS_OUTBOUND_DISABLED.
PLATFORM_SUBACCOUNT_CREATION="off"
# Modelo das subcontas novas: BAAS (produção, depois do acordo com o Asaas) ou
# STANDARD (só no piloto). A criação só fica disponível com STANDARD até o lote
# de documentos.
PLATFORM_ASAAS_SUBACCOUNT_MODEL="STANDARD"
# true no piloto: a conta de recebimentos só depois da 1ª mensalidade paga.
# Ausente vale true; só o literal false desliga.
PLATFORM_SUBACCOUNT_REQUIRES_PAID="true"
# Opcional: saída por IP fixo para as chamadas ao Asaas.
PLATFORM_ASAAS_EGRESS_PROXY_URL=""
# Interruptor de emergência: true corta as chamadas de saída ao Asaas; os
# webhooks continuam sendo persistidos.
PLATFORM_ASAAS_OUTBOUND_DISABLED="false"
# Origem pública do backend para os webhooks (ADR de hosts) e e-mail de alertas.
PLATFORM_WEBHOOK_ORIGIN=""
PLATFORM_OPS_EMAIL=""
# Cofre de segredos: env até o piloto; aws-kms antes do self-service.
PLATFORM_SECRETS_KEK_PROVIDER="env"
# Id da KEK atual; a chave fica em PLATFORM_SECRETS_KEK_<ID> (32 bytes em
# base64, variável sensível por ambiente), ex.: PLATFORM_SECRETS_KEK_K1="".
PLATFORM_SECRETS_KEK_CURRENT=""
PLATFORM_SECRETS_KMS_KEY_ARN=""
# Self-service com KMS exige federação OIDC; não use access keys estáticas.
AWS_ROLE_ARN=""
AWS_WEB_IDENTITY_TOKEN_FILE=""
# Chaves de HMAC com 32 caracteres ou mais.
PLATFORM_SECRET_FINGERPRINT_KEY=""
PLATFORM_TRIAL_SECRET=""
# Arquivo JSON externo com kind/version/textSha256 dos termos APROVADOS publicados.
# Metadados somente; não é rascunho nem prova automática de aprovação jurídica.
PLATFORM_LEGAL_DOCUMENTS_FILE=""
# JSON externo kind -> texto UTF-8 exato de cada documento APROVADO publicado.
# GET /api/onboarding/options confere cada SHA-256 contra o manifesto acima.
# Não usar rascunhos nem normalizar espaços/quebras de linha; signup off não lê.
PLATFORM_LEGAL_DOCUMENT_CONTENTS_FILE=""
# off | shadow | on. A virada para on exige platform-preflight verde.
PLATFORM_SUBSCRIPTION_ENFORCEMENT="off"
# off | on (backend e web). on só depois do H6, da homologação e do KMS.
PLATFORM_SELF_SERVICE_SIGNUP="off"
# Referências env: de TenantIntegration; false depois da importação para o cofre.
INTEGRATION_ENV_REFS_ALLOWED="true"
# Captcha invisível (Turnstile) do cadastro do dono.
# POST de organização envia o token em X-Platform-Captcha; widget action=onboarding.
# Validação confere o hostname app da borda e ocorre só em pedidos novos.
PLATFORM_CAPTCHA_SITE_KEY=""
PLATFORM_CAPTCHA_SECRET_KEY=""

# Host Expo: origem do painel web para OAuth Zoho e consulta de assinatura no navegador.
# Somente origem, sem path/query/credenciais; HTTPS em produção. Sem fallback.
# Não define destino da API nem troca callbacks; o usuário autentica no painel.
EXPO_PUBLIC_WEB_URL=""
