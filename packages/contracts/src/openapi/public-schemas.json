{
  "components": {
    "schemas": {
      "PublicApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PublicCategoryList": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID único da categoria"
            },
            "name": {
              "type": "string",
              "description": "Nome da categoria"
            },
            "description": {
              "description": "Descrição da categoria",
              "nullable": true,
              "type": "string"
            },
            "icon": {
              "description": "Ícone da categoria",
              "nullable": true,
              "type": "string"
            },
            "iconColor": {
              "description": "Cor do ícone",
              "type": "string"
            },
            "bgColor": {
              "description": "Cor de fundo",
              "type": "string"
            },
            "fontColor": {
              "description": "Cor da fonte",
              "type": "string"
            },
            "slug": {
              "description": "Slug da categoria",
              "type": "string"
            },
            "_count": {
              "description": "Contadores",
              "type": "object",
              "properties": {
                "equipments": {
                  "type": "number"
                }
              }
            },
            "createdAt": {
              "description": "Data de criação",
              "anyOf": [
                {
                  "type": "string"
                },
                {}
              ]
            },
            "updatedAt": {
              "description": "Data de atualização",
              "anyOf": [
                {
                  "type": "string"
                },
                {}
              ]
            }
          },
          "required": [
            "id",
            "name"
          ]
        }
      },
      "PublicContactAccepted": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "messageId": {
                "type": "string"
              },
              "deliveryStatus": {
                "type": "string",
                "enum": [
                  "queued"
                ]
              }
            },
            "required": [
              "messageId",
              "deliveryStatus"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "PublicContactRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nome completo"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Email para contato"
          },
          "phone": {
            "description": "Telefone para contato",
            "type": "string"
          },
          "cpf": {
            "description": "CPF do cliente",
            "type": "string"
          },
          "cnpj": {
            "description": "CNPJ da empresa",
            "type": "string"
          },
          "cep": {
            "description": "CEP do cliente",
            "type": "string"
          },
          "company": {
            "description": "Empresa/Construtora",
            "type": "string"
          },
          "equipment": {
            "description": "Equipamento de interesse",
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Mensagem"
          },
          "tenantSlug": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "email",
          "message",
          "tenantSlug"
        ]
      },
      "PublicEquipmentList": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID único do equipamento"
            },
            "name": {
              "type": "string",
              "description": "Nome do equipamento"
            },
            "description": {
              "description": "Descrição do equipamento",
              "nullable": true,
              "type": "string"
            },
            "pricePerDay": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true,
              "description": "Preço por dia"
            },
            "categoryId": {
              "description": "ID da categoria",
              "type": "string"
            },
            "category": {
              "description": "Categoria completa (quando expandida)",
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "icon": {
                  "nullable": true,
                  "type": "string"
                },
                "iconColor": {
                  "type": "string"
                },
                "bgColor": {
                  "type": "string"
                },
                "fontColor": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            },
            "imageUrl": {
              "description": "URL da imagem principal",
              "nullable": true,
              "type": "string"
            },
            "images": {
              "description": "URLs das imagens",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "isAvailable": {
              "type": "boolean",
              "description": "Disponibilidade"
            },
            "specifications": {
              "description": "Especificações técnicas",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "reviews": {
              "description": "Avaliações",
              "type": "array",
              "items": {}
            },
            "createdAt": {
              "description": "Data de criação",
              "anyOf": [
                {
                  "type": "string"
                },
                {}
              ]
            },
            "updatedAt": {
              "description": "Data de atualização",
              "anyOf": [
                {
                  "type": "string"
                },
                {}
              ]
            }
          },
          "required": [
            "id",
            "name",
            "pricePerDay",
            "isAvailable"
          ]
        }
      },
      "PublicQuoteCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quoteCode": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING"
            ]
          },
          "total": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "equipmentId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "days": {
                  "type": "number"
                },
                "pricePerDay": {
                  "type": "string"
                },
                "total": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "equipmentId",
                "quantity",
                "days",
                "pricePerDay",
                "total"
              ]
            }
          }
        },
        "required": [
          "id",
          "quoteCode",
          "status",
          "total",
          "items"
        ]
      },
      "PublicQuoteRequest": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "minLength": 1,
            "description": "Nome do cliente"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Email do cliente"
          },
          "customerPhone": {
            "type": "string",
            "description": "Telefone do cliente"
          },
          "cpf": {
            "description": "CPF do cliente",
            "type": "string"
          },
          "cnpj": {
            "description": "CNPJ da empresa",
            "type": "string"
          },
          "cep": {
            "description": "CEP do cliente",
            "type": "string"
          },
          "customerCompany": {
            "description": "Empresa do cliente",
            "type": "string"
          },
          "message": {
            "description": "Mensagem adicional",
            "type": "string"
          },
          "deliveryType": {
            "description": "Tipo de entrega",
            "type": "string",
            "enum": [
              "DELIVERY",
              "PICKUP"
            ]
          },
          "deliveryAddress": {
            "description": "Endereço de entrega",
            "type": "object",
            "properties": {
              "cep": {
                "type": "string",
                "description": "CEP"
              },
              "logradouro": {
                "type": "string",
                "description": "Logradouro"
              },
              "numero": {
                "type": "string",
                "description": "Número"
              },
              "complemento": {
                "description": "Complemento",
                "type": "string"
              },
              "bairro": {
                "type": "string",
                "description": "Bairro"
              },
              "cidade": {
                "type": "string",
                "description": "Cidade"
              },
              "estado": {
                "type": "string",
                "description": "Estado"
              }
            },
            "required": [
              "cep",
              "logradouro",
              "numero",
              "bairro",
              "cidade",
              "estado"
            ]
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "equipmentId": {
                  "type": "string",
                  "description": "ID do equipamento"
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMinimum": true,
                  "description": "Quantidade"
                },
                "days": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMinimum": true,
                  "description": "Dias de locação"
                },
                "startDate": {
                  "description": "Data de início da locação",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {}
                  ]
                },
                "endDate": {
                  "description": "Data de fim da locação",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {}
                  ]
                },
                "includeWeekends": {
                  "description": "Incluir finais de semana na contagem",
                  "type": "boolean"
                }
              },
              "required": [
                "equipmentId",
                "quantity",
                "days"
              ]
            },
            "description": "Itens do orçamento"
          },
          "tenantSlug": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "customerName",
          "customerEmail",
          "customerPhone",
          "items",
          "tenantSlug"
        ]
      },
      "PublicTenantQuery": {
        "type": "object",
        "properties": {
          "tenantSlug": {
            "type": "string",
            "minLength": 1,
            "description": "Slug explícito de uma locadora ativa; não existe locadora padrão"
          }
        },
        "required": [
          "tenantSlug"
        ]
      }
    }
  }
}
