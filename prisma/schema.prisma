generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  platformStaff PlatformStaff?
  memberships Membership[]
  clientProfiles ClientProfile[]
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  password       String?
  role           Role       @default(CLIENT)
  authEmailVerified Boolean @default(false)
  authSessions AuthSession[]
  authAccounts AuthAccount[]
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  cnpj           String?    @unique
  cpf            String?    @unique
  phone          String?
  company        String?
  accounts       Account[]
  addresses      Address[]
  auditLogs      AuditLog[]
  cart           Cart[]
  approvedQuotes Quote[]    @relation("ApprovedQuotes")
  clientDocuments ClientDocument[]
  financialSettingsUpdated FinancialSetting[] @relation("FinancialSettingsUpdatedBy")
  quoteAdjustments QuoteAdjustment[] @relation("QuoteAdjustmentsCreatedBy")
  rejectedQuotes Quote[]    @relation("RejectedQuotes")
  quotes         Quote[]
  rentals        rentals[]
  sessions       Session[]
  uploadedClientDocuments ClientDocument[] @relation("UploadedClientDocuments")
  zohoMailToken  ZohoMailToken[]

  @@map("users")
}

model ZohoMailToken {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  accountId    String?
  datacenter   String   @default("com")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("zoho_mail_tokens")
  @@index([tenantId])
  @@unique([id, tenantId])
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  UNKNOWN
}

model ZohoMailCommand {
  id String @id @default(cuid())
  tenantId String
  userId String
  operation String
  accountId String
  grantId String
  keyHash String
  requestHash String
  status String @default("PROCESSING")
  responseBody String? @db.Text
  httpStatus Int?
  createdAt DateTime @default(now())
  completedAt DateTime?
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict, onUpdate: NoAction, map: "zoho_mail_commands_membership_fk")
  @@unique([tenantId, userId, operation, keyHash], map: "zoho_mail_commands_tenant_user_operation_key")
  @@index([tenantId, status, createdAt], map: "zoho_mail_commands_tenant_status_created")
  @@map("zoho_mail_commands")
}

model WhatsAppConversation {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id            String   @id @default(cuid())
  phone         String
  displayName   String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      WhatsAppMessage[]

  @@map("whatsapp_conversations")
  @@index([tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, phone])
}

model WhatsAppMessage {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id               String                   @id @default(cuid())
  conversationId   String
  conversation     WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId String?
  direction        WhatsAppMessageDirection
  type             WhatsAppMessageType      @default(TEXT)
  body             String                   @db.Text
  mediaUrl         String?
  timestamp        DateTime                 @default(now())
  status           String?
  createdAt        DateTime                 @default(now())

  @@index([conversationId])
  @@map("whatsapp_messages")
  @@index([tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, providerMessageId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verificationtokens")
}

model Address {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id           String   @id @default(cuid())
  userId       String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model Cart {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
  @@index([tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, userId])
}

model CartItem {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id          String    @id @default(cuid())
  cartId      String
  equipmentId String
  quantity    Int
  days        Int
  pricePerDay Decimal
  finalPrice  Decimal?
  createdAt   DateTime  @default(now())
  cart        Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([cartId, equipmentId])
  @@index([equipmentId])
  @@map("cart_items")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model Category {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id          String      @id @default(uuid()) @db.Uuid
  name        String
  description String?
  icon        String?
  iconColor   String      @default("#3B82F6")
  bgColor     String      @default("#EFF6FF")
  fontColor   String      @default("#1E40AF")
  slug        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  placement   String?
  customIcon  Json?
  equipments  Equipment[]

  @@map("categories")
  @@index([tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, slug])
}

model Equipment {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id                     String          @id @default(cuid())
  name                   String
  description            String?
  pricePerDay            Decimal
  images                 String[]
  available              Boolean         @default(true)
  categoryId             String          @db.Uuid
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  biweeklyDiscount       Int?            @default(0)
  dailyDiscount          Int?            @default(0)
  maxStock               Int?            @default(1)
  monthlyDiscount        Int?            @default(0)
  popularPeriod          String?         @default("weekly")
  weeklyDiscount         Int?            @default(0)
  specifications         Json?
  biweeklyDirectValue    Decimal?
  biweeklyUseDirectValue Boolean         @default(false)
  dailyDirectValue       Decimal?
  dailyUseDirectValue    Boolean         @default(false)
  monthlyDirectValue     Decimal?
  monthlyUseDirectValue  Boolean         @default(false)
  weeklyDirectValue      Decimal?
  weeklyUseDirectValue   Boolean         @default(false)
  // Períodos de locação oferecidos (desativar = não oferecer orçamento por esse período)
  dailyRentalEnabled     Boolean         @default(true)
  weeklyRentalEnabled    Boolean         @default(true)
  biweeklyRentalEnabled  Boolean        @default(true)
  monthlyRentalEnabled   Boolean        @default(true)
  depreciationRate       Decimal?        @db.Decimal
  hourMeter              Decimal?        @db.Decimal
  odometer               Decimal?        @db.Decimal
  purchaseDate           DateTime?
  purchasePrice          Decimal?        @db.Decimal
  partsLossHistory       Json?          // Histórico de perdas de peças
  partsLossCount         Int?            @default(0) // Contador de perdas de peças
  cartItems              CartItem[]
  units                  EquipmentUnit[]
  category               Category        @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_category")
  maintenances           Maintenance[]
  quoteItems             QuoteItem[]
  rental_items           rental_items[]

  @@index([categoryId])
  @@map("equipments")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model EquipmentUnit {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id           String              @id @default(cuid())
  equipmentId  String
  uniqueCode   String
  status       EquipmentUnitStatus @default(AVAILABLE)
  hourMeter    Decimal?            @db.Decimal
  odometer     Decimal?            @db.Decimal
  serialNumber String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  equipment    Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@map("equipment_units")
  @@index([tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, uniqueCode])
}

model Quote {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id                  String        @id @default(cuid())
  quoteCode           String?
  legacyExternalCode  String?
  name                String
  email               String
  phone               String
  company             String?
  message             String?
  total               Decimal       @default(0)
  status              QuoteStatus   @default(PENDING)
  userId              String?
  clientDeletedAt     DateTime?     // Soft delete feito pelo cliente
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  cep                 String?
  cnpj                String?
  cpf                 String?
  adminNotes          String?
  approvedAt          DateTime?
  approvedBy          String?
  convertedToRentalId String?
  paymentTerms        QuotePaymentTerms @default(UPFRONT)
  deliveryAddress     Json?
  deliveryFee         Decimal?
  deliveryType        DeliveryType?
  deposit             Decimal?
  discount            Decimal?
  endDate             DateTime?
  finalTotal          Decimal?
  internalNotes       String?
  pickupFee           Decimal?
  priority            Int?          @default(0)
  rejectedAt          DateTime?
  rejectedBy          String?
  rejectionReason     String?
  startDate           DateTime?
  subtotal            Decimal?
  taxes               Decimal?
  validUntil          DateTime?
  // Sistema de ajuste de valor final com justificativa
  originalTotal       Decimal?          // Valor original completo (antes do ajuste)
  priceAdjustmentReason String?         // Justificativa obrigatória ao editar valor
  priceAdjustedAt     DateTime?        // Data/hora da edição do valor
  priceAdjustedBy     String?           // ID do usuário que editou o valor
  // Sistema de multa por atraso
  lateFee             Decimal?          // Valor da multa calculada
  lateFeeApproved     Boolean?          @default(false) // Se admin aprovou aplicação da multa
  lateFeeApprovedAt   DateTime?         // Data de aprovação da multa
  lateFeeApprovedBy   String?           // ID do admin que aprovou a multa
  // Registro de danos e mau uso
  damages             Json?             // Registro de danos
  misuse              Json?             // Registro de mau uso
  // Classificação tributária da operação
  operationType       OperationType?
  serviceAmount       Decimal?          @db.Decimal
  adjustments         QuoteAdjustment[]
  payments            Payment[]
  items               QuoteItem[]
  approvedByUser      User?         @relation("ApprovedQuotes", fields: [approvedBy], references: [id])
  rejectedByUser      User?         @relation("RejectedQuotes", fields: [rejectedBy], references: [id])
  user                User?         @relation(fields: [userId], references: [id])
  rentals             rentals[]

  @@index([userId])
  @@index([endDate])
  @@index([status])
  @@index([approvedBy])
  @@index([rejectedBy])
  @@map("quotes")
  @@index([tenantId])
  @@unique([id, tenantId])
  @@unique([tenantId, quoteCode])
}

model QuoteItem {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id              String    @id @default(cuid())
  quoteId         String
  equipmentId     String
  quantity        Int       @default(1)
  days            Int       @default(1)
  pricePerDay     Decimal
  total           Decimal
  // Datas específicas deste item (definidas na página de detalhes do equipamento)
  startDate       DateTime?
  endDate         DateTime?
  // Indica se finais de semana estão incluídos na contagem de dias
  includeWeekends Boolean   @default(false)
  // Informações de preço aplicado
  appliedDiscount Decimal? // Desconto percentual aplicado
  appliedPeriod   String? // Período aplicado (daily, weekly, biweekly, monthly)
  useDirectValue  Boolean   @default(false) // Se usou valor direto ao invés de desconto
  directValue     Decimal? // Valor direto aplicado (se useDirectValue = true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  quote           Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([quoteId])
  @@map("quote_items")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model rental_items {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id              String    @id
  rentalid        String
  equipmentid     String
  quantity        Int       @default(1)
  priceperday     Decimal   @db.Decimal
  totaldays       Int
  totalprice      Decimal   @db.Decimal
  // Datas específicas deste item (nullable para compatibilidade com rentals existentes)
  startDate       DateTime? @db.Timestamp(6)
  endDate         DateTime? @db.Timestamp(6)
  includeWeekends Boolean   @default(false)
  createdat       DateTime? @default(now()) @db.Timestamp(6)
  updatedat       DateTime? @default(now()) @db.Timestamp(6)
  equipments      Equipment @relation(fields: [equipmentid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rentals         rentals   @relation(fields: [rentalid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([equipmentid])
  @@index([rentalid])
  @@index([tenantId])
  @@unique([id, tenantId])
}

model rentals {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id            String         @id
  startdate     DateTime       @db.Timestamp(6)
  enddate       DateTime       @db.Timestamp(6)
  total         Decimal        @db.Decimal
  status        RentalStatus   @default(PENDING)
  userid        String
  createdat     DateTime?      @default(now()) @db.Timestamp(6)
  updatedat     DateTime?      @default(now()) @db.Timestamp(6)
  checkInAt     DateTime?      @db.Timestamp(6)
  checkOutAt    DateTime?      @db.Timestamp(6)
  extensionDays Int?
  extensionFee  Decimal?       @db.Decimal
  lateFee       Decimal?       @db.Decimal
  notes            String?
  quoteId          String?
  clientDeletedAt  DateTime?  // Soft delete pelo cliente: esconde do histórico sem afetar o admin
  contract         Contract?
  clientDocuments ClientDocument[]
  deliveries    Delivery[]
  payments      Payment[]
  rental_items  rental_items[]
  quote         Quote?         @relation(fields: [quoteId], references: [id])
  users         User           @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userid])
  // Índice único parcial mantido somente em SQL (Prisma não expressa índice parcial):
  // rentals_tenant_quote_unique ("tenantId", "quoteId") WHERE "tenantId" IS NOT NULL
  // AND "quoteId" IS NOT NULL — uma locação por orçamento em cada locadora
  // (migrations 202609250005 e 202609260001). Não aceite DROP gerado por migrate diff.
  @@index([quoteId])
  @@index([tenantId])
  @@unique([id, tenantId])
}

model Setting {
  publicBaseUrl String?
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String? @unique
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id                  String   @id @default(uuid())
  companyPhone        String   @default("")
  companyIconUrl      String   @default("")
  aboutUsText         String   @default("")
  companyAddress      String   @default("")
  heroCarousel        Json     @default("[]")
  contactEmail        String   @default("")
  socialLinks         Json     @default("{}")
  // Onda 135 (A4, migration 202610080101): padrão neutro; o antigo trazia o nome da GB e a leitura pública da vitrine
  // expõe o título (T12).
  seoTitle            String   @default("")
  seoDescription      String   @default("Locação de equipamentos para construção civil com qualidade e segurança")
  themeColorPrimary   String   @default("#ea580c")
  maintenanceMode     Boolean  @default(false)
  analyticsTrackingId String   @default("")
  footerText          String   @default("")
  businessHours       Json     @default("{}")
  supportChat         Boolean  @default(true)
  whatsappNumber      String   @default("")
  favicon             String   @default("")
  logoSecondary       String   @default("")
  defaultLanguage     String   @default("pt-BR")
  baseCurrency        String   @default("BRL")
  maintenanceMessage  String   @default("Site em manutenção. Voltamos em breve!")
  smtpConfig          Json     @default("{}")
  uploadLimits        Json     @default("{}")
  securityConfig      Json     @default("{}")
  customCss           String   @default("")
  customJs            String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  marketingEmail      String   @default("")
  waveAnimation       String   @default("animated")
  // Onda 134 (migration 202610060201): conteúdo institucional (contrato SiteContentSchema) e textos legais da vitrine
  // (StorefrontLegalDocumentSchema). Documento e data da publicação sempre juntos (CHECK); tamanho por octet_length.
  siteContent             Json      @default("{}")
  termsDocument           Json?
  termsPublishedAt        DateTime?
  privacyDocument         Json?
  privacyPublishedAt      DateTime?
  returnPolicyDocument    Json?
  returnPolicyPublishedAt DateTime?

  @@map("settings")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model Maintenance {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id          String            @id @default(cuid())
  equipmentId String
  type        MaintenanceType
  scheduledAt DateTime
  completedAt DateTime?
  cost        Decimal?          @db.Decimal
  laborCost   Decimal?          @db.Decimal
  partsCost   Decimal?          @db.Decimal
  description String?
  notes       String?
  technician  String?
  status      MaintenanceStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  equipment   Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@map("maintenances")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model Payment {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  attempts      PaymentAttempt[]
  id            String        @id @default(cuid())
  rentalId      String?
  quoteId       String?
  amount        Decimal       @db.Decimal
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  billingStatus PaymentBillingStatus @default(AWAITING_PAYMENT)
  type          PaymentType   @default(RENTAL)
  paidAt        DateTime?     @db.Timestamp(6)
  dueDate       DateTime      @db.Timestamp(6)
  grossAmount   Decimal?      @db.Decimal
  netAmount     Decimal?      @db.Decimal
  taxRate       Decimal?      @db.Decimal
  taxDocumentType TaxDocumentType?
  invoiceNumber String?
  boletoIssuedAt DateTime?
  invoiceIssuedAt DateTime?
  settledAt     DateTime?
  transactionId String?
  pixCode       String?
  pixQrCode     String?
  metadata      Json?

  // Classificação da operação
  operationType     OperationType?
  rentalAmount      Decimal?  @db.Decimal
  serviceAmount     Decimal?  @db.Decimal

  // Snapshot do detalhamento tributário
  taxRegimeSnapshot TaxRegime?
  issAmount         Decimal?  @db.Decimal
  irpjAmount        Decimal?  @db.Decimal
  csllAmount        Decimal?  @db.Decimal
  pisCofinsAmount   Decimal?  @db.Decimal
  simplesAmount     Decimal?  @db.Decimal

  // NFS-e (para integração futura)
  nfseNumber        String?
  nfseIssuedAt      DateTime?

  // Detalhamento tributário completo (JSON extensível)
  taxBreakdown      Json?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  quote         Quote?        @relation(fields: [quoteId], references: [id])
  rental        rentals?      @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@index([quoteId])
  @@index([billingStatus])
  // Índice único parcial mantido somente em SQL (Prisma não expressa índice parcial):
  // payments_quote_method_type_active_unique ("quoteId", "method", "type")
  // WHERE "quoteId" IS NOT NULL AND "status" NOT IN ('CANCELLED', 'REFUNDED') — no máximo
  // uma cobrança vigente por orçamento/meio/tipo; cobranças canceladas ou estornadas
  // permanecem como histórico (migration 202609260004). Não aceite DROP gerado por migrate diff.
  @@map("payments")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model FinancialSetting {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  id        String   @id @default(cuid())
  cpfRate   Decimal  @default(6.0) @db.Decimal
  cnpjRate  Decimal  @default(2.5) @db.Decimal
  cniRate   Decimal  @default(6.0) @db.Decimal
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Regime tributário
  taxRegime         TaxRegime @default(SIMPLES_NACIONAL)

  // ISS
  issRate           Decimal   @default(2.5) @db.Decimal
  issExemptRental   Boolean   @default(true)

  // Lucro Presumido (taxas efetivas sobre receita bruta)
  irpjPresumidoRate Decimal?  @db.Decimal
  csllPresumidoRate Decimal?  @db.Decimal
  pisCofinsRate     Decimal?  @db.Decimal

  // Simples Nacional
  simplesAnexo      String?   @default("III")
  simplesAliquota   Decimal?  @db.Decimal

  // Reforma Tributária (futuro)
  ibsCbsRate        Decimal?  @db.Decimal
  ibsCbsActive      Boolean   @default(false)

  updatedByUser User? @relation("FinancialSettingsUpdatedBy", fields: [updatedBy], references: [id])

  @@index([updatedBy])
  @@map("financial_settings")
  @@index([tenantId])
  @@unique([id, tenantId])
}

model QuoteAdjustment {
  // Nullable while unassigned legacy records remain quarantined.
  tenantId String?
