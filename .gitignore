cartão*.pdf
*.cnpj*.pdf

# Host web: cópia real de public/ gerada por tools/sync-web-public.mjs (predev/prebuild); nunca junção nem symlink.
# O trinco (.lock, e o .stale de um trinco abandonado posto de lado) só existe enquanto uma sincronização roda.
apps/clients/web/public
apps/clients/web/.sync-web-public.lock*

# Caches e saídas geradas da modernização
.openapi-gen/
.turbo/
apps/clients/mobile/dist-export/
apps/clients/mobile/.expo/
# Projetos nativos gerados pelo expo prebuild / expo run:*
apps/clients/mobile/android/
apps/clients/mobile/ios/
