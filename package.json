{
  "name": "gb-locacoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm db:generate",
    "build": "pnpm build:web && pnpm build:api",
    "arch": "node tools/arch-check.mjs",
    "tokens": "node tools/token-check.mjs",
    "check:tokens": "node tools/token-propagation-check.mjs",
    "check:test-names": "node tools/test-colocation-check.mjs",
    "ratchet:guard": "node tools/ratchet-guard.mjs",
    "hygiene": "node tools/hygiene-check.mjs",
    "test:gates": "vitest run --config vitest.unit.config.ts tests/unit/architecture-runtime.test.ts tests/unit/token-check.test.ts tests/unit/test-colocation-check.test.ts tests/unit/ratchet-guard.test.ts tests/unit/ratchet-guard.hygiene.test.ts tests/unit/hygiene-check.test.ts tests/unit/eslint-config.test.ts tests/unit/eslint-runtime-rewrite.test.ts tests/unit/stylelint-css-structure.test.ts tests/unit/ci-workflow.test.ts tests/unit/pre-commit-hook.test.ts tests/unit/destructive-commands.test.ts tests/unit/retired-artifacts.test.ts tests/unit/env-manifest.test.ts",
    "test:visual-tools": "vitest run --config tests/visual/vitest.config.ts",
    "visual:capture": "playwright test -c tests/visual/playwright.visual.config.ts",
    "visual:compare": "node tools/visual-baseline/compare.mjs",
    "typecheck": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/domain/tsconfig.json && tsc -p packages/design-tokens/tsconfig.json && tsc -p packages/backend/tsconfig.json && tsc -p packages/ui/tsconfig.json && tsc -p packages/ui/tsconfig.native.json && tsc -p packages/ui/tsconfig.native.test.json && tsc -p packages/frontend/tsconfig.json && tsc -p packages/frontend/tsconfig.native.json && tsc -p packages/frontend/tsconfig.native.test.json && tsc -p apps/clients/web/tsconfig.json && tsc -p apps/clients/mobile/tsconfig.json && tsc -p apps/clients/mobile/tsconfig.test.json && tsc -p apps/services/api/tsconfig.json",
    "build:web": "pnpm --filter @gb-locacoes/web build",
    "bundle:mobile": "pnpm --filter @gb-locacoes/mobile bundle",
    "postinstall": "node tools/generate-prisma-client.mjs",
    "codex:setup": "pnpm install && pnpm db:generate",
    "db:generate": "node tools/generate-prisma-client.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:phones": "tsx scripts/seed-company-phones.ts",
    "db:clean:quotes": "tsx scripts/clean-quotes.ts",
    "db:backfill:quote-codes": "tsx scripts/backfill-quote-codes.ts",
    "db:dedupe:boletos": "tsx scripts/dedupe-quote-boleto-payments.ts",
    "db:clean:rejected-rentals": "tsx scripts/clean-rejected-quote-rentals.ts",
    "db:clean:maintenance": "tsx scripts/remove-maintenance-records.ts",
    "db:studio": "prisma studio",
    "dev": "concurrently --kill-others --names \"API,WEB\" \"pnpm --filter @gb-locacoes/api dev\" \"pnpm --filter @gb-locacoes/web dev --hostname 0.0.0.0 --port 3001\"",
    "dev:browsertools": "concurrently --kill-others --names \"NEXT,TOOLS\" \"pnpm dev\" \"npx @agentdeskai/browser-tools-server@1.2.0\"",
    "browsertools": "npx @agentdeskai/browser-tools-server@1.2.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "format:all": "pnpm format && pnpm format:md",
    "fix:encoding": "node scripts/fix-encoding.mjs",
    "fix:changelog": "node scripts/fix-encoding.mjs CHANGELOG.md",
    "check:grammar": "node scripts/fix-grammar.mjs",
    "check:grammar:changelog": "node scripts/fix-grammar.mjs CHANGELOG.md",
    "fix:grammar": "node scripts/apply-grammar-fixes.mjs",
    "fix:grammar:changelog": "node scripts/apply-grammar-fixes.mjs CHANGELOG.md",
    "lint": "eslint . --no-color --quiet",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "lint:all": "pnpm lint:fix && pnpm lint",
    "lint:css": "stylelint \"packages/**/*.css\" \"apps/**/*.css\" --max-warnings 0",
    "lint:md": "markdownlint \"**/*.md\" --ignore \"node_modules\"",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore \"node_modules\" --fix",
    "fix:md": "pnpm format:md && pnpm lint:md:fix",
    "prepare": "husky",
    "quality:check": "pnpm format:check && pnpm lint && pnpm lint:md",
    "quality:fix": "pnpm format && pnpm lint:fix && pnpm fix:md",
    "test": "vitest --run",
    "test:platform": "vitest --run --config vitest.platform.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:ui": "vitest --ui",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsx scripts/generate-openapi-zod.ts",
    "openapi:dev": "tsx scripts/generate-openapi-zod.ts --watch",
    "docs:validate": "node scripts/validate-docs-indexes.js",
    "design-system:lint": "pnpm lint && stylelint \"**/*.{css,scss}\"",
    "design-system:lint:fix": "pnpm lint:fix && stylelint \"**/*.{css,scss}\" --fix",
    "ci:test": "pnpm db:generate && pnpm lint && pnpm test && pnpm type-check",
    "ci:full": "pnpm db:generate && pnpm lint && pnpm test && pnpm type-check && pnpm build",
    "check:outdated-safe": "pnpm outdated \"@radix-ui/*\" \"@testing-library/*\" date-fns lucide-react || echo No outdated packages found",
    "update:safe": "pnpm update @radix-ui/react-* @testing-library/* date-fns lucide-react",
    "verify:after-update": "pnpm run build && pnpm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:doctor": "storybook doctor",
    "storybook:check": "storybook automigrate --dry-run",
    "storybook:info": "storybook info",
    "icon:convert": "node scripts/convert-svg-to-icon.cjs",
    "perf:test": "node scripts/performance-test.js --all-devices --page=Homepage",
    "perf:mobile": "node scripts/performance-test.js --device=lowEndMobile --page=Homepage",
    "perf:desktop": "node scripts/performance-test.js --device=oldDesktop --page=Homepage",
    "perf:lighthouse": "node scripts/lighthouse-batch.js --page=Homepage",
    "perf:lighthouse:mobile": "node scripts/lighthouse-batch.js --device=mobile --page=Homepage",
    "perf:lighthouse:desktop": "node scripts/lighthouse-batch.js --device=desktop --page=Homepage",
    "perf:report": "node scripts/generate-performance-report.js",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:all": "pnpm test:unit && pnpm test:security && pnpm test:identity && pnpm test:contract && pnpm test:platform && pnpm test:mobile && pnpm test:web && pnpm test:api && pnpm test:integration && pnpm test:visual-tools",
    "modernization:inventory": "node tools/modernization-inventory.mjs --output .tmp/modernization/inventory.json",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:identity": "vitest run --config vitest.identity.config.ts",
    "test:mobile": "vitest run --config apps/clients/mobile/vitest.config.mts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "tenant:check": "node tools/tenant-database-check.mjs",
    "tenant:slug-preflight": "node tools/tenant-slug-preflight.mjs",
    "build:api": "pnpm --filter @gb-locacoes/api build",
    "test:api": "vitest run --config vitest.api.config.ts",
    "platform:preflight": "node tools/platform-preflight.mjs",
    "platform:secrets-import": "tsx tools/integration-secrets-import.mjs",
    "platform:provision": "tsx tools/platform-provision-tenant.mjs"
  },
  "dependencies": {
    "@gb-locacoes/backend": "workspace:*",
    "@gb-locacoes/contracts": "workspace:*",
    "@gb-locacoes/design-tokens": "workspace:*",
    "@gb-locacoes/domain": "workspace:*",
    "@gb-locacoes/frontend": "workspace:*",
    "@gb-locacoes/ui": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "googleapis": "^182.0.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.30.0",
    "sharp": "^0.35.4",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/ui": "^5.0.2",
    "chrome-launcher": "^1.2.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lighthouse": "^13.5.0",
    "markdownlint-cli": "^0.49.1",
    "next-openapi-gen": "^1.8.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "puppeteer": "25.12.0",
    "react-hook-form": "^7.88.0",
    "storybook": "10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.27.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "tailwindcss": "4.3.3",
      "glob": "^11.0.3",
      "rimraf": "^6.0.1",
      "fetch-blob": "^3.2.0",
      "formdata-polyfill": "^4.0.10",
      "baseline-browser-mapping": "^2.9.15",
      "axios": "^1.12.0",
      "cookie": "^0.7.0",
      "qs": "6.14.2",
      "tmp": "^0.2.4",
      "preact": "^10.28.2",
      "@isaacs/brace-expansion": "^5.0.1",
      "lodash": "^4.17.23",
      "minimatch": ">=10.2.1",
      "ajv-formats>ajv": ">=8.18.0",
      "table>ajv": ">=8.18.0",
      "hono": ">=4.11.10",
      "svelte": "^5.46.4",
      "@sveltejs/kit": "^2.49.5",
      "markdown-it": "^14.1.1",
      "typescript": "5.9.3"
    }
  }
}
