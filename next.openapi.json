{
  "openapi": "3.0.0",
  "info": {
    "title": "Plataforma de Locação de Equipamentos API",
    "version": "1.0.0",
    "description": "API de locadoras independentes. Endpoints públicos exigem tenantSlug explícito. Endpoints administrativos exigem autenticação e Membership ativa na locadora selecionada; User.role não concede acesso por empresa."
  },
  "servers": [
    {
      "url": "/api",
      "description": "API no mesmo host da aplicação"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "defaultResponseSet": "common",
  "responseSets": {
    "common": [
      "400",
      "500"
    ],
    "auth": [
      "400",
      "401",
      "403",
      "500"
    ],
    "public": [
      "400",
      "404",
      "409",
      "500"
    ]
  },
  "errorConfig": {
    "template": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "{{ERROR_MESSAGE}}"
        },
        "code": {
          "type": "string",
          "example": "{{ERROR_CODE}}"
        }
      }
    },
    "codes": {
      "400": {
        "description": "Bad Request",
        "variables": {
          "ERROR_MESSAGE": "Invalid request parameters",
          "ERROR_CODE": "BAD_REQUEST"
        }
      },
      "401": {
        "description": "Unauthorized",
        "variables": {
          "ERROR_MESSAGE": "Authentication required",
          "ERROR_CODE": "UNAUTHORIZED"
        }
      },
      "403": {
        "description": "Forbidden",
        "variables": {
          "ERROR_MESSAGE": "Access denied",
          "ERROR_CODE": "FORBIDDEN"
        }
      },
      "404": {
        "description": "Not Found",
        "variables": {
          "ERROR_MESSAGE": "Resource not found",
          "ERROR_CODE": "NOT_FOUND"
        }
      },
      "409": {
        "description": "Conflict",
        "variables": {
          "ERROR_MESSAGE": "Resource already exists",
          "ERROR_CODE": "CONFLICT"
        }
      },
      "500": {
        "description": "Internal Server Error",
        "variables": {
          "ERROR_MESSAGE": "An unexpected error occurred",
          "ERROR_CODE": "INTERNAL_ERROR"
        }
      }
    }
  },
  "apiDir": "./apps/services/api/src/app/api",
  "schemaDir": [
    "./apps/services/api/src",
    "./packages/contracts/src/openapi"
  ],
  "schemaType": "zod",
  "docsUrl": "api-docs",
  "ui": "swagger",
  "outputFile": "openapi.json",
  "outputDir": "./public",
  "includeOpenApiRoutes": false,
  "debug": false,
  "schemaFiles": [
    "./packages/contracts/src/openapi/public-schemas.json"
  ]
}
